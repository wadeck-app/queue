#!/usr/bin/env node
'use strict';
const { execFileSync, execSync } = require('child_process');
const os = require('os');

const PLATFORM_PKG = {
  'win32-x64':    '@wadeck/{{PKG_PREFIX}}-win32-x64',
  'darwin-arm64': '@wadeck/{{PKG_PREFIX}}-darwin-arm64',
  'darwin-x64':   '@wadeck/{{PKG_PREFIX}}-darwin-x64',
};

const arch = os.arch() === 'arm64' ? 'arm64' : 'x64';
const key = `${process.platform}-${arch}`;
const pkgName = PLATFORM_PKG[key];
if (!pkgName) {
  process.stderr.write(`{{CLI_NAME}}: unsupported platform ${key}\n`);
  process.exit(1);
}

const ext = process.platform === 'win32' ? '.exe' : '';

let launcherPath;
try {
  launcherPath = require.resolve(`${pkgName}/{{CLI_NAME}}${ext}`);
} catch {
  process.stderr.write(`{{CLI_NAME}}: platform package ${pkgName} missing -- installing...\n`);
  try {
    const out = execSync(`npm install -g ${pkgName}`, { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] });
    if (out) process.stdout.write(out);
  } catch (installErr) {
    if (installErr.stdout) process.stdout.write(installErr.stdout);
    if (installErr.stderr) process.stderr.write(installErr.stderr);
    process.stderr.write(`{{CLI_NAME}}: install failed (exit ${installErr.status})\n`);
    process.exit(1);
  }
  try {
    launcherPath = require.resolve(`${pkgName}/{{CLI_NAME}}${ext}`);
  } catch {
    process.stderr.write(
      `{{CLI_NAME}}: installed ${pkgName} but cannot resolve binary -- try: npm install -g @wadeck/{{PKG_PREFIX}}\n`
    );
    process.exit(1);
  }
}

const bundlePath = require('path').join(__dirname, '..', '{{CLI_NAME}}.cjs');

// On Windows the Go launcher binary is compiled as SUBSYSTEM:WINDOWS (GUI application).
// Its hasConsole() check fails when spawned from a terminal, causing node's stdio to be
// redirected to NUL and swallowing all output. Bypass the launcher for short-lived
// read-only commands so their output reaches the terminal.
const PASSTHROUGH_FLAGS = ['--version', '-v', '--pid', '--help', '-h'];
const _args = process.argv.slice(2);

function _runWithExit(bin, binArgs) {
  try {
    execFileSync(bin, binArgs, {
      stdio: 'inherit',
      env: { ...process.env, LAUNCHER_BUNDLE_OVERRIDE: bundlePath },
    });
  } catch (err) {
    process.exit(err != null && typeof err === 'object' && 'status' in err && typeof err.status === 'number' ? err.status : 1);
  }
}

if (process.platform === 'win32' && _args.some(function(a) { return PASSTHROUGH_FLAGS.includes(a); })) {
  _runWithExit(process.execPath, [bundlePath].concat(_args));
} else {
  _runWithExit(launcherPath, _args);
}
