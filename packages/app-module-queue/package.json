{
  "name": "@wadeck-app/app-module-queue",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist-module"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "app-core-cli check .",
    "bundle": "app-core-cli package .",
    "pretest": "cd ../queue-core && npm run build",
    "test": "vitest run --bail=1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist-module"
  },
  "dependencies": {
    "@wadeck-app/plugin-github": "*",
    "@wadeck-app/queue-core": "*",
    "@wadeck-app/queue-relay-client": "*",
    "@wadeck-app/singleton-daemon-kit": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@wadeck-app/app-core-cli": "^2026.10.19-056-69a287b1",
    "@wadeck-app/app-core-sdk": "^2026.10.22-072-f1ca3cff",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  }
}
