package main

// resource.syso (Windows PE version info) is generated by goversioninfo from versioninfo.json.

import (
	"os"
	"path/filepath"

	launcher "wadeck.ch/singleton-daemon-kit/go-launcher"
)

// queue's own launcher template, passed as the third argument of the SDK's build.sh (see
// ci/scripts/build-launcher.mjs). It differs from the SDK default template in one thing: the config dir
// honours QUEUE_CONFIG_DIR, exactly like the Node side (queue-core getQueueConfigDir). Without it
// `QUEUE_CONFIG_DIR=<tmp> queue start` ran the daemon in <tmp> while the launcher wrote its log and
// config.launcher-pid into the real ~/.config/queue and looked config.port up there.
//
// Precedence (same as Node, plus the launcher-only --config):
//   1. --config <dir> (or a legacy leading positional path) in the arguments
//   2. QUEUE_CONFIG_DIR
//   3. $XDG_CONFIG_HOME/{{.DefaultConfigDir}}
//   4. $HOME/.config/{{.DefaultConfigDir}}

// hasExplicitConfig reports whether the arguments already name the config dir the way
// launcher.ResolveConfigDir understands it: "--config <dir>" anywhere, or a leading absolute /
// home-relative path.
func hasExplicitConfig(args []string) bool {
	for _, a := range args {
		if a == "--config" {
			return true
		}
	}
	if len(args) == 0 || args[0] == "" {
		return false
	}
	first := args[0]
	if first[0] == '/' || first[0] == '~' {
		return true
	}
	return len(first) >= 3 && first[1] == ':' && (first[2] == '\\' || first[2] == '/')
}

func main() {
	exe, _ := os.Executable()
	// Resolve symlinks so exeDir points to the real binary directory, not the symlink's directory.
	if resolved, err := filepath.EvalSymlinks(exe); err == nil {
		exe = resolved
	}
	exeDir := filepath.Dir(exe)

	rawArgs := os.Args[1:]
	// Feeding QUEUE_CONFIG_DIR through "--config" reuses the SDK's handling (~ expansion, removal of
	// the flag from the arguments node receives) and skips the legacy ~/.queue migration, which
	// must never touch the real home when a custom dir is requested.
	if env := os.Getenv("QUEUE_CONFIG_DIR"); env != "" && !hasExplicitConfig(rawArgs) {
		rawArgs = append([]string{"--config", env}, rawArgs...)
	}
	configDir, args := launcher.ResolveConfigDir("{{.DefaultConfigDir}}", rawArgs)

	launcher.Run(launcher.Config{
		ConfigDir:  configDir,
		Args:       args,
		NodeScript: filepath.Join(exeDir, "{{.NodeScript}}"),
		AppName:    "{{.AppName}}",
		CLIFlags: []string{
{{range .CLIFlags}}			"{{.}}",
{{end}}		},
		SilentFlags: []string{
{{range .SilentFlags}}			"{{.}}",
{{end}}		},
		UpdateCmd: []string{
{{range .UpdateCmd}}			"{{.}}",
{{end}}		},
	})
}
