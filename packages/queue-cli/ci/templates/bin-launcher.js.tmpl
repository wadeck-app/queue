#!/usr/bin/env node
'use strict';
const { execFileSync, execSync } = require('child_process');
const os = require('os');

// Determine the stdio mode and whether to print a notice to the user.
// @param {string[]} rawArgs - process.argv.slice(2)
// @param {boolean} stdinIsTTY - process.stdin.isTTY
// @returns {{stdio: string, args: string[], auto: boolean, notice: string|null}}
//   - stdio: 'inherit' or 'ignore'
//   - args: filtered args without --cli-foreground/--cli-background
//   - auto: true if stdio was chosen by auto-detection (not explicit flags)
//   - notice: user-facing message when auto-detected non-TTY, or null
function resolveStdio(rawArgs, stdinIsTTY) {
  const cliName = '{{CLI_NAME}}';

  // Check for explicit flags
  var hasBackground = rawArgs.includes('--cli-background');
  var hasForeground = rawArgs.includes('--cli-foreground');

  // Strip flags from args to forward to the command
  var args = rawArgs.filter(function(a) { return a !== '--cli-background' && a !== '--cli-foreground'; });

  var stdio;
  var auto = false;

  if (!hasBackground && !hasForeground) {
    // Auto-detect: pipe context (non-TTY) → NUL handles to prevent AllocConsole()
    // from libuv when a GUI-parent (flow.exe SUBSYSTEM:WINDOWS) passes PIPE handles.
    // "queue events list|show" only read the event catalog, and the version and help flags only print: an agent in a background shell (non-TTY) needs their output
    var readOnlyCatalog = ['--version', '-v', '-V', '--help', '-h'].includes(args[0]) ||
      (cliName === 'queue' && args[0] === 'events' && (args[1] === 'list' || args[1] === 'show'));
    stdio = stdinIsTTY || readOnlyCatalog ? 'inherit' : 'ignore';
    // auto=true only when auto-detection chose 'ignore' (non-TTY)
    auto = !stdinIsTTY && !readOnlyCatalog;
  } else {
    // Last flag wins, default 'ignore'
    stdio = 'ignore';
    for (var i = 0; i < rawArgs.length; i++) {
      if (rawArgs[i] === '--cli-background') stdio = 'ignore';
      if (rawArgs[i] === '--cli-foreground') stdio = 'inherit';
    }
  }

  var notice = null;
  // Print notice only if: auto-detected (non-TTY), output was suppressed, not 'start' background command
  if (auto && stdio === 'ignore' && args[0] !== 'start') {
    notice = '[' + cliName + '] stdin is not a TTY: command output is discarded. Re-run with --cli-foreground to see it (or --cli-background to silence this notice).';
  }

  return { stdio: stdio, args: args, auto: auto, notice: notice };
}

// Build the command that installs the platform package at the bundle's OWN exact version.
// Never 'latest': an unversioned install leaves a top-level copy that drifts from this bundle.
// @param {string} pkgName - platform package name
// @param {unknown} version - version field of this package's package.json
// @returns {string} the npm install command
// @throws {Error} when the version is missing or not a plain version string
function buildInstallCommand(pkgName, version) {
  if (typeof version !== 'string' || !/^[0-9A-Za-z][0-9A-Za-z.+-]*$/.test(version)) {
    throw new Error('cannot read a valid version from this package\'s package.json (got ' + JSON.stringify(version) + ')');
  }
  return 'npm install -g ' + pkgName + '@' + version;
}

// Explain why a child could not even be started (missing exec bit, missing file...). Without it the shim would exit
// with no output at all, which is what hid a platform package whose binary had lost its exec bit.
// @param {string} cliName - CLI name for the message prefix
// @param {string} bin - the file that could not be started
// @param {unknown} err - the error thrown by execFileSync
// @returns {string|null} the message, or null when the child did run (it exited with a status or was killed by a signal)
function describeSpawnFailure(cliName, bin, err) {
  if (err == null || typeof err !== 'object') return null;
  if (typeof err.status === 'number' || err.signal) return null;
  if (typeof err.code !== 'string') return null;
  var fix = err.code === 'EACCES'
    ? 'chmod +x ' + bin + ' (or reinstall: npm install -g @wadeck-app/{{PKG_PREFIX}})'
    : 'npm install -g @wadeck-app/{{PKG_PREFIX}}';
  return cliName + ': cannot start ' + bin + ': ' + err.code + ': ' + err.message + '. Fix: ' + fix;
}

// Export for testing
if (typeof module !== 'undefined' && module.exports) {
  module.exports.describeSpawnFailure = describeSpawnFailure;
  module.exports.resolveStdio = resolveStdio;
  module.exports.buildInstallCommand = buildInstallCommand;
}

// Execute only when run as a script, not when required
if (require.main === module) {
  const PLATFORM_PKG = {
    'win32-x64':    '@wadeck-app/{{PKG_PREFIX}}-win32-x64',
    'darwin-arm64': '@wadeck-app/{{PKG_PREFIX}}-darwin-arm64',
  };

  const arch = os.arch() === 'arm64' ? 'arm64' : 'x64';
  const key = `${process.platform}-${arch}`;
  const pkgName = PLATFORM_PKG[key];
  if (!pkgName) {
    process.stderr.write(`{{CLI_NAME}}: unsupported platform ${key}\n`);
    process.exit(1);
  }

  const ext = process.platform === 'win32' ? '.exe' : '';

  let launcherPath;
  try {
    launcherPath = require.resolve(`${pkgName}/{{CLI_NAME}}${ext}`);
  } catch {
    let installCmd;
    try {
      installCmd = buildInstallCommand(pkgName, require('../package.json').version);
    } catch (verErr) {
      process.stderr.write(
        `{{CLI_NAME}}: platform package ${pkgName} missing and it cannot be installed automatically: ${verErr.message}. ` +
        `Fix: reinstall with npm install -g @wadeck-app/{{PKG_PREFIX}}\n`
      );
      process.exit(1);
    }
    process.stderr.write(`{{CLI_NAME}}: platform package ${pkgName} missing -- running: ${installCmd}\n`);
    try {
      const out = execSync(installCmd, { encoding: 'utf8', windowsHide: true, stdio: ['pipe', 'pipe', 'pipe'] });
      if (out) process.stdout.write(out);
    } catch (installErr) {
      if (installErr.stdout) process.stdout.write(installErr.stdout);
      if (installErr.stderr) process.stderr.write(installErr.stderr);
      process.stderr.write(`{{CLI_NAME}}: install failed (exit ${installErr.status}). Run it yourself: ${installCmd}\n`);
      process.exit(1);
    }
    try {
      launcherPath = require.resolve(`${pkgName}/{{CLI_NAME}}${ext}`);
    } catch {
      process.stderr.write(
        `{{CLI_NAME}}: ran ${installCmd} but cannot resolve the binary. Fix: npm install -g @wadeck-app/{{PKG_PREFIX}}\n`
      );
      process.exit(1);
    }
  }

  const bundlePath = require('path').join(__dirname, '..', '{{CLI_NAME}}.cjs');

  // On Windows the Go launcher binary is compiled as SUBSYSTEM:WINDOWS (GUI application).
  // Its hasConsole() check fails when spawned from a terminal, causing node's stdio to be
  // redirected to NUL and swallowing all output. Bypass the launcher for short-lived
  // read-only commands so their output reaches the terminal.
  const PASSTHROUGH_FLAGS = ['--version', '-v', '--pid', '--help', '-h'];
  const _rawArgs = process.argv.slice(2);

  // Resolve stdio and get user notice if needed
  var _resolved = resolveStdio(_rawArgs, process.stdin.isTTY);
  var _stdio = _resolved.stdio;
  var _args = _resolved.args;
  var _notice = _resolved.notice;

  // Print notice to stderr before running the command
  if (_notice) {
    process.stderr.write(_notice + '\n');
  }

  function _runWithExit(bin, binArgs) {
    try {
      execFileSync(bin, binArgs, {
        stdio: _stdio,
        windowsHide: true,
        env: { ...process.env, LAUNCHER_BUNDLE_OVERRIDE: bundlePath },
      });
    } catch (err) {
      var failure = describeSpawnFailure('{{CLI_NAME}}', bin, err);
      if (failure) process.stderr.write(failure + '\n');
      process.exit(err != null && typeof err === 'object' && 'status' in err && typeof err.status === 'number' ? err.status : 1);
    }
  }

  // Bypass the Go launcher for ALL commands except 'start', on every platform.
  // Only 'start' needs the launcher (it spawns the daemon background process).
  // Every other command is short-lived and its stdout/stderr must reach the terminal.
  // On Windows the GUI launcher (hasConsole=false) swallows stdout/stderr of child node processes.
  // Elsewhere the launcher adds nothing for these commands (queue sets no update/restart sentinel) and costs a process
  // plus a rewrite of config.launcher-pid, and running node directly keeps a non-executable launcher from breaking them.
  var _bypassLauncher = _args[0] !== 'start';

  if (_bypassLauncher) {
    _runWithExit(process.execPath, [bundlePath].concat(_args));
  } else {
    _runWithExit(launcherPath, _args);
  }
}
