{
  // Typechecks the files that sit outside tsconfig.json's "include" (rootDir src): the vitest config, its global setup and its setup file. Emits nothing, never published.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": ".",
    "declarationDir": null
  },
  "include": ["vitest.config.ts", "vitest.globalSetup.ts", "vitest.setup.ts"],
  "references": []
}
