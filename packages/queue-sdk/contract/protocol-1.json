[
  {
    "name": "a client that predates versioning sends no protocol",
    "request": { "event": "on.contract.legacy", "payload": { "a": 1 } },
    "response": { "status": "queued", "eventId": "present" }
  },
  {
    "name": "a client speaking 1.0.0",
    "request": { "event": "on.contract.current", "payload": {}, "protocol": "1.0.0" },
    "response": { "status": "queued", "eventId": "present" }
  },
  {
    "name": "a client speaking a later MINOR of 1.x (additive changes are compatible)",
    "request": { "event": "on.contract.minor", "payload": {}, "protocol": "1.9.0" },
    "response": { "status": "queued", "eventId": "present" }
  },
  {
    "name": "a client speaking a MAJOR the daemon does not accept is rejected and nothing is recorded",
    "request": { "event": "on.contract.future", "payload": {}, "protocol": "2.0.0" },
    "response": { "status": "rejected", "supported": "^1.0.0", "eventId": "absent" }
  },
  {
    "name": "a malformed protocol is rejected, not guessed",
    "request": { "event": "on.contract.malformed", "payload": {}, "protocol": "banana" },
    "response": { "status": "rejected", "supported": "^1.0.0", "eventId": "absent" }
  },
  {
    "name": "1.2.0: a client naming a registered project (the placeholder stands for its id) is accepted",
    "request": { "event": "on.contract.project", "payload": {}, "protocol": "1.2.0", "project": "<registered-project>" },
    "response": { "status": "queued", "eventId": "present" }
  },
  {
    "name": "1.2.0: a client naming a project the registry does not know is rejected and nothing is recorded",
    "request": { "event": "on.contract.unknown-project", "payload": {}, "protocol": "1.2.0", "project": "deadbeef" },
    "response": { "status": "rejected", "eventId": "absent" }
  }
]
